{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/card",
      "destination": "/api/card"
    },
    {
      "source": "/stack",
      "destination": "/api/stack"
    },
    {
      "source": "/stats",
      "destination": "/api/stats"
    },
    {
      "source": "/terminal",
      "destination": "/api/terminal"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
